#!/usr/bin/env bash
# Idempotent setup for orbs and CI: the pinned Rust toolchain, the locked crates,
# the gate's secret scanner and this repository's git hooks. Android SDK/NDK
# setup is separate: tools/setup_android.py (see docs/DEVELOPMENT.md).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v rustup >/dev/null && [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
        sh -s -- -y --default-toolchain none --profile minimal >/dev/null
fi
export PATH="$HOME/.cargo/bin:$PATH"
rustup toolchain install >/dev/null # the toolchain rust-toolchain.toml pins
cargo fetch --locked >/dev/null

gitleaks_version=8.30.1
gitleaks_sha256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
bin="$HOME/.local/bin"
if [ "$("$bin/gitleaks" version 2>/dev/null || true)" != "$gitleaks_version" ]; then
    scratch=$(mktemp -d)
    curl -sSfL -o "$scratch/gitleaks.tar.gz" \
        "https://github.com/gitleaks/gitleaks/releases/download/v$gitleaks_version/gitleaks_${gitleaks_version}_linux_x64.tar.gz"
    echo "$gitleaks_sha256  $scratch/gitleaks.tar.gz" | sha256sum -c --quiet
    mkdir -p "$bin"
    tar -xzf "$scratch/gitleaks.tar.gz" -C "$bin" gitleaks
    rm -rf "$scratch"
fi

git config core.hooksPath .githooks

if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
    echo "setup: a GitHub token is present"
else
    echo "setup: no GitHub token is present"
fi
echo "setup: done; put $HOME/.cargo/bin and $bin on PATH"
